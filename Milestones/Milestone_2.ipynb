    {
      "cell_type": "code",
      "source": [
        "def map_score(actual, preds):\n",
        "    if actual in preds:\n",
        "        rank = preds.index(actual) + 1\n",
        "        return 1 / rank\n",
        "    return 0"
      ],
      "metadata": {
        "id": "GYYtNeIIPkrC"
      },
      "execution_count": 31,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "combined_texts = []\n",
        "\n",
        "for row in train_ds:\n",
        "    full_text = (\n",
        "        row[\"prompt\"] + \" \" +\n",
        "        row[\"A\"] + \" \" +\n",
        "        row[\"B\"] + \" \" +\n",
        "        row[\"C\"] + \" \" +\n",
        "        row[\"D\"] + \" \" +\n",
        "        row[\"E\"]\n",
        "    )\n",
        "    combined_texts.append(full_text)"
      ],
      "metadata": {
        "id": "sj24JRStPknR"
      },
      "execution_count": 32,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "vectorizer = TfidfVectorizer(stop_words=\"english\")\n",
        "vectorizer.fit(combined_texts)"
